# ============================================
# EventEase - .gitignore
# MEAN Stack Project
# ============================================

# ============================================
# Dependencies
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Keep package-lock.json for dependency consistency
# Uncomment the next line if you want to ignore it
# package-lock.json

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.local
.env.development
.env.production
.env.test
*.pem
*.key
*.crt

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
backend/logs/
backend/*.log
Monitor.sh
*.log.*
/var/log/eventease-*.log
/var/log/nginx/eventease-*.log
/var/log/mongodb/*.log

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3
/data/
/mongodb-data/
*.dump

# ============================================
# Build & Distribution
# ============================================
dist/
build/
*.tsbuildinfo
.next/
out/
.cache/

# ============================================
# IDE & Editor Files
# ============================================
# VSCode
.vscode/
*.code-workspace

# IntelliJ IDEA / WebStorm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ============================================
# OS Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*
.nfs*

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
.cache/
tmp/
temp/

# ============================================
# Testing & Coverage
# ============================================
coverage/
.nyc_output/
*.lcov
.jest/

# ============================================
# PM2
# ============================================
.pm2/
ecosystem.config.js
# Note: ecosystem.config.js might be needed, uncomment if you want to track it

# ============================================
# MongoDB
# ============================================
/data/db/
mongodb-data/
*.bson

# ============================================
# Python (if using for local server)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt

# ============================================
# VM & Deployment Specific
# ============================================
# VM setup scripts might generate these
*.pid
*.seed
*.pid.lock

# ============================================
# Optional: Keep these if needed
# ============================================
# Uncomment if you want to ignore these
# package-lock.json
# .env.example (keep example files)

